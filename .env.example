# --- Telegram bot ---
# @BotFather'dan olingan token (ikkala rejim uchun ham kerak)
TELEGRAM_BOT_TOKEN=

# Mini App manzili (web_app tugmalari uchun; https bo'lishi shart)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Ovozni matnga aylantirish: Google Cloud Speech-to-Text ---
# Ikkitasining biri yetarli:
#   a) API kaliti (Speech-to-Text API yoqilgan loyihada)
GOOGLE_SPEECH_API_KEY=
#   b) Service account — JSON fayl mazmuni (yoki uning base64 nusxasi)
GOOGLE_SERVICE_ACCOUNT_JSON=
# (b variantining muqobili: JSON o'rniga faqat shu ikki qiymat)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Tanib olish tili va (ixtiyoriy) qo'shimcha tillar
GOOGLE_SPEECH_LANGUAGE=uz-UZ
GOOGLE_SPEECH_ALT_LANGUAGES=
# Model: default / latest_long / latest_short
GOOGLE_SPEECH_MODEL=default

# Zaxira variant: Google sozlanmagan bo'lsa, OpenAI Whisper ishlatiladi
OPENAI_API_KEY=

# --- Ma'lumotlar bazasi (ixtiyoriy) ---
# Berilsa, bot yozuvlarni to'g'ridan-to'g'ri bazaga saqlaydi ("klassik" rejim).
# Berilmasa, bot Mini App'ga deep-link tugmasini yuboradi (qurilma xotirasi).
DATABASE_URL="file:./dev.db"

# Yangi Telegram foydalanuvchilari uchun boshlang'ich valyuta
DEFAULT_CURRENCY=KRW

# --- Webhook rejimi (ixtiyoriy, lekin tavsiya etiladi) ---
# O'rnatilsa, webhook faqat shu maxfiy sarlavha bilan kelgan so'rovlarni qabul qiladi
TELEGRAM_WEBHOOK_SECRET=
